APP_NAME="Justice and Law"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# If deployed under a subfolder of the main site (e.g. https://supremecourt.ge/journal),
# set APP_URL/ASSET_URL to that full path AND set ROUTE_PREFIX below —
# see README "Subfolder დეპლოი".
APP_URL=http://localhost
ASSET_URL="${APP_URL}"
# Only for subfolder deployment via .htaccess rewriting (not needed for a subdomain
# or an Apache Alias/vhost setup) — must match the subfolder name, e.g. ROUTE_PREFIX=journal
ROUTE_PREFIX=
APP_LOCALE=ka
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Production default is MySQL. For local testing without a MySQL server,
# switch DB_CONNECTION to sqlite and create an empty database/database.sqlite file.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=justice_and_law
DB_USERNAME=root
DB_PASSWORD=
# Prefix applied to every table (pages, settings, issues, articles, users, migrations, ...).
DB_PREFIX=jr_

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Only needed for subfolder deployment — scopes the cookie to that path, e.g. SESSION_PATH=/jurnal
SESSION_PATH=/

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Seeded by database/seeders/AdminUserSeeder.php — change the password after first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
